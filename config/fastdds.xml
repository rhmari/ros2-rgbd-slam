<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS (ROS 2 Humble's default middleware) profile for large camera images.
     The default shared-memory segment is 512 KB, smaller than one RGB (0.9 MB) or depth (1.2 MB)
     frame, so images fell back to fragmented UDP and many synchronized RGB/depth/info sets were lost.
     This keeps shared memory with a 64 MB segment, plus UDP for discovery and anything else. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>shm_large</transport_id>
            <type>SHM</type>
            <segment_size>67108864</segment_size>
        </transport_descriptor>
        <transport_descriptor>
            <transport_id>udp</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="large_images" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>shm_large</transport_id>
                <transport_id>udp</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
